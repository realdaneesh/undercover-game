PORT=3001
CLIENT_ORIGINS=http://localhost:5173
# Production: NODE_ENV=production and CLIENT_ORIGINS=https://your-project.vercel.app
# Multiple exact HTTPS origins can be comma-separated. No paths or wildcards.
# Render supplies PORT automatically; do not upload this development .env file.
# Render has one reverse proxy. Use 0 when running directly.
TRUST_PROXY=0
NODE_ENV=development
